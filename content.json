  "games": [
    {
      "id": "zelda-botw",
      "type": "game",
      "title": "塞尔达传说 旷野之息",
      "latin": "THE LEGEND OF ZELDA: BREATH OF THE WILD",
      "year": "2017",
      "creator": "Nintendo EPD",
      "platform": "Nintendo Switch",
      "genre": "开放世界 / 冒险",
      "score": 9.8,
      "tier": "hang",
      "quote": "原来世界本身，就可以是答案。",
      "review": [
        "第一次爬出初始台地，看见远处的双子山和更远处的海拉鲁城堡时，我确实在屏幕前愣了很久。它没有把“开放世界”做成一长串问号，而是把风、火、雷、时间和地形都变成可以互动的工具。",
        "我花了很多时间不做主线：追一头鹿、在雨里等雷停、用一把火把把整片草原点着，再看着火势顺风蔓延。那些没有奖励的瞬间，反而最像一场真正的旅行。",
        "孤独感是它最珍贵的东西。一个人走在旷野里，只有脚步声和远处的钢琴声；但每次点亮神庙、遇见旅人，又会觉得这个世界在轻轻回应你。"
      ],
      "memory": "在雨里爬不上悬崖，干脆坐看云海；第一次用盾反打死守护者；把波克布林全部推进河里。",
      "tags": [
        "开放世界",
        "冒险",
        "孤独感",
        "Switch",
        "神作"
      ],
